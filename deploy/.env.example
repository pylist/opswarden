# Copy to deploy/.env. This file contains placeholders only; never put the
# master key, passwords, TOTP seeds, browser JWTs, or Agent Tokens here.
OPSWARDEN_HOSTNAME=opswarden.example.com
OPSWARDEN_TLS_EMAIL=ops@example.com

# Pin these to the checked-out release/commit. Do not use "latest".
OPSWARDEN_VERSION=1.0.0
OPSWARDEN_REVISION=0123456789abcdef0123456789abcdef01234567
SOURCE_DATE_EPOCH=0

# Absolute Linux host paths. The ownership commands are in docs/operations.md.
OPSWARDEN_STATE_PATH=/srv/opswarden/state
OPSWARDEN_MASTER_KEY_PATH=/srv/opswarden/secrets/master.key
CADDY_DATA_PATH=/srv/opswarden/caddy/data
CADDY_CONFIG_PATH=/srv/opswarden/caddy/config

# Dedicated private backend. The trusted proxy is only Caddy's exact /32.
OPSWARDEN_BACKEND_SUBNET=172.31.250.0/29
OPSWARDEN_APP_IP=172.31.250.2
OPSWARDEN_CADDY_IP=172.31.250.3

# Leave empty after bootstrap. During initial-owner setup, use only the
# operator workstation's exact IPv4 /32 or IPv6 /128; never 0.0.0.0/0 or ::/0.
OPSWARDEN_INTERNAL_CIDRS=
